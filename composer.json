{
    "name": "geraldhofbauerweb/craft-nightshift",
    "description": "Nightshift — a polished dark theme for the Craft CMS control panel, with a one-click sun/moon toggle in the header and a remembered preference (no flash of light on load).",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "control panel",
        "cp",
        "dark mode",
        "darkmode",
        "dark theme",
        "dark",
        "night",
        "nightshift",
        "night mode",
        "theme",
        "ui"
    ],
    "support": {
        "email": "info@geraldhofbauer.net",
        "source": "https://github.com/GeraldHofbauerWeb/craft-nightshift",
        "issues": "https://github.com/GeraldHofbauerWeb/craft-nightshift/issues",
        "docs": "https://github.com/GeraldHofbauerWeb/craft-nightshift/blob/main/README.md"
    },
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.0.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "geraldhofbauerweb\\nightshift\\": "src/"
        }
    },
    "extra": {
        "handle": "nightshift",
        "name": "Nightshift",
        "description": "A dark theme for the Craft CMS control panel, with a one-click header toggle.",
        "developer": "Gerald Hofbauer",
        "developerUrl": "https://geraldhofbauer.net",
        "developerEmail": "info@geraldhofbauer.net",
        "documentationUrl": "https://github.com/GeraldHofbauerWeb/craft-nightshift",
        "class": "geraldhofbauerweb\\nightshift\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
